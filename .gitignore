# secrets — never commit the stream key
.env
*.env.local

# per-machine hardware wiring, generated by tools/bootstrap-node.sh
playout/compose.hwaccel.yml
# the restored station config lives on the node, not in git
playout/ersatztv-config/
playout/ersatztv-config.bak.*

# media & generated video (lives on the playout machine, not in git)
media/
*.mp4
*.mkv
*.mov
*.m2ts

# owncast runtime data (lives on the VPS)
data/

# dev noise
node_modules/
.DS_Store
*.log

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
__pycache__/
*.pyc

# agent scratch and journals
.claude/
