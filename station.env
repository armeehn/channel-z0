# station.env — who this station is. Edit, then run: python3 tools/rebrand.py
# Every value below is the upstream one; change what you like, keep the rest.
# Values are plain text, no quotes needed. See FORKING.md.

# the station, as spoken and printed
STATION_NAME=Channel Z0

# the short form: masthead, list prefix, prose
STATION_SHORT=Z0

# the dial position on cards and intervals
CHANNEL_LABEL=CH 0

# compact label in the now-playing prefix (letters and digits only)
CHANNEL_TAG=CH0

# document/desig code on every card
DESIGNATION=RL-Z0

# one line under the name
TAGLINE=a local channel, for locals

# the midnight sign-off card
SIGNOFF_LINE=GOODNIGHT, LOCALS

# the nightly flagship
FLAGSHIP_SHOW=Ground Zero

# the sponsor's own show
LAB_SHOW=Lab Hour

# machine name: worker, swarm id, schedule file names
SLUG=channel-z0

# GitHub owner/name
REPO=armeehn/channel-z0

# the storefront
SITE_DOMAIN=ch0.ripostelabs.xyz

# the tower (Owncast)
WATCH_DOMAIN=watch.ch0.ripostelabs.xyz

# ad submissions and rights claims
CONTACT_EMAIL=ch0@ripostelabs.xyz

# copyright holder
SPONSOR_LEGAL=Riposte Laboratories Inc.

# the sponsor
SPONSOR_NAME=Riposte Laboratories

# the sponsor, short
SPONSOR_SHORT=Riposte Labs

# the sponsor's footer line
SPONSOR_MANTRA=PARRY · RIPOSTE · RECYCLE · REPEAT

# merch
SHOP_URL=https://shop.ripostelabs.xyz

# the sponsor's site
SPONSOR_DOMAIN=ripostelabs.xyz

# weather desk and cards
CITY=Kelowna

# province/state on the weather desk
REGION=BC

# station clock (IANA)
TIMEZONE=America/Vancouver

# weather desk latitude
WX_LAT=49.88307

# weather desk longitude
WX_LON=-119.48568
