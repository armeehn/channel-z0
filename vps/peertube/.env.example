# Channel Z0 — PeerTube tower environment (vps/peertube/)
# Copy to .env IN THIS DIRECTORY, fill in real values, never commit the result.
# docker compose reads this file both for ${...} interpolation in the compose
# file AND (via env_file) as the PeerTube container's environment.

# --- Public identity -------------------------------------------------------
# The hostname Caddy terminates TLS for and reverse-proxies to :9000. Reuse the
# tower's existing watch subdomain so nothing else in the repo has to change.
PEERTUBE_WEBSERVER_HOSTNAME=watch.ch0.ripostelabs.xyz
PEERTUBE_WEBSERVER_PORT=443
PEERTUBE_WEBSERVER_HTTPS=true
# We sit behind Caddy on the same host, so trust the local proxy. Include the
# Docker bridge subnet so PeerTube reads the real client IP, not the gateway.
PEERTUBE_TRUST_PROXY=["127.0.0.1", "loopback", "172.16.0.0/12"]

# --- Database (must match the postgres service in docker-compose.yml) -------
PEERTUBE_DB_HOSTNAME=postgres
PEERTUBE_DB_USERNAME=peertube
PEERTUBE_DB_PASSWORD=CHANGE-ME-db-password
PEERTUBE_DB_SSL=false
# Leave EMPTY so the DB name is exactly "peertube" (= compose's POSTGRES_DB).
PEERTUBE_DB_SUFFIX=

# --- Redis (jobs, cache, live state) ---------------------------------------
PEERTUBE_REDIS_HOSTNAME=redis

# --- First-boot admin + the instance secret --------------------------------
# The root admin's password is printed ONCE in the logs on first start:
#   docker compose logs peertube | grep -A1 "Admin password"
PEERTUBE_ADMIN_EMAIL=ch0@ripostelabs.xyz
# Long random string (e.g. `openssl rand -hex 32`). Changing it later logs
# everyone out — set it once.
PEERTUBE_SECRET=CHANGE-ME-long-random-secret

# --- Email (optional) ------------------------------------------------------
# Leave blank to disable outbound mail. A one-person station rarely needs it;
# just remember the admin password from the logs above.
PEERTUBE_SMTP_HOSTNAME=
PEERTUBE_SMTP_PORT=
PEERTUBE_SMTP_USERNAME=
PEERTUBE_SMTP_PASSWORD=
PEERTUBE_SMTP_FROM=
