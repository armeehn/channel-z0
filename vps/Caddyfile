# Channel Z0 — Caddy config (VPS).
# Automatic HTTPS for the Owncast watch page + HLS.
#
# The storefront no longer lives here — it's on Cloudflare
# (ch0.ripostelabs.xyz, and channelz0.tv once purchased). So Caddy's only job on
# the VPS is to terminate TLS for the tower and re-serve Owncast, PLUS hand the
# cross-origin storefront the CORS header it needs to pull the stream + status.
#
# Replace the hostname with yours, place at /etc/caddy/Caddyfile, then:
#   sudo systemctl reload caddy

watch.ch0.ripostelabs.xyz {
    # Every viewer polls /api/status every 30 s and Owncast marks it no-store.
    # Ten seconds of shared cache keeps the tower's load flat once this host
    # sits behind Cloudflare (docs/scaling.tex, tier 2). The leading ">" makes
    # Caddy replace the header AFTER the upstream response, otherwise
    # Owncast's own value wins.
    @status path /api/status
    header @status >Cache-Control "public, s-maxage=10"

    reverse_proxy 127.0.0.1:8080 {
        # The page is served from another origin (Cloudflare), so the HLS player
        # and the /api/status polling need permissive CORS.
        #
        # Do NOT add `header_down -Access-Control-Allow-Origin` above this line to
        # "strip whatever Owncast set first". Caddy applies header DELETIONS AFTER
        # SETS, so the delete removes the header the next line just wrote and the
        # response carries no CORS at all - the storefront player goes blank, with
        # nothing in any log to say why. `set` already replaces an upstream value.
        header_down Access-Control-Allow-Origin "*"
    }
}

# When channelz0.tv goes live, point watch.channelz0.tv at this VPS and
# uncomment the block below — Caddy fetches the certificate on first hit. You can
# run both hostnames at once (old links keep working) or retire the old one once
# the site's WATCH_HOST is switched over.
#
# watch.channelz0.tv {
#     reverse_proxy 127.0.0.1:8080 {
#         header_down Access-Control-Allow-Origin "*"
#     }
# }
