# Channel Z0 — station environment
# Copy to .env (playout PC / playout/ compose dir) or /etc/channel-z0.env (for
# the systemd unit), fill in real values. NEVER commit the filled-in version.

# --- Domains (see docs/build-guide.tex, Phase 0) --------------------------
# The storefront is hosted on Cloudflare. For now that's a subdomain of
# ripostelabs.xyz; channelz0.tv is available and is the eventual home — when
# it's purchased, only these values + DNS change.
Z0_SITE_DOMAIN=ch0.ripostelabs.xyz
# The tower (Owncast) on the VPS. The site's HLS + status calls hit this host.
Z0_WATCH_DOMAIN=watch.ch0.ripostelabs.xyz
# When channelz0.tv goes live, switch these two to:
#   Z0_SITE_DOMAIN=channelz0.tv
#   Z0_WATCH_DOMAIN=watch.channelz0.tv
# (and flip WATCH_HOST/AD_EMAIL in site/index.html — see build-guide Phase 4).
# Where the RTMP push goes. Defaults to Z0_WATCH_DOMAIN. Set it once the watch
# host is proxied through a CDN, which cannot carry RTMP: a DNS-only name for
# the same box (docs/scaling.tex, tier 2).
#Z0_INGEST_DOMAIN=ingest.ch0.ripostelabs.xyz

# --- The one secret ------------------------------------------------------
# The Owncast stream key you set in /admin (Phase 1.4). Long and random.
Z0_STREAM_KEY=CHANGE-ME

# --- Playout -------------------------------------------------------------
# The channel NUMBER, not an index into a list. ErsatzTV publishes at
# /iptv/channel/<number>.ts and the number is whatever the station was built
# with. Channel Z0 is number 0 — /iptv/channel/1.ts returns 404 on it. Get this
# wrong and the node passes every health check while publishing nothing, which
# is the least helpful way for a station to fail.
# tools/bootstrap-node.sh reads the real number out of the station image.
Z0_CHANNEL_NUMBER=0
Z0_CHANNEL_URL=http://127.0.0.1:8409/iptv/channel/0.ts
# The media library root (tools/make-media-tree.sh builds it here).
Z0_MEDIA_ROOT=/media/channelz0

# --- Now-playing bridge (optional; playout/nowplaying.py) ----------------
# Feeds the live "NOW SHOWING" title from ErsatzTV into Owncast, which the
# storefront then displays. Needs an Owncast access token created at
# https://<watch-domain>/admin/access-tokens with the "set stream title" scope.
Z0_CHANNEL_XMLTV=http://127.0.0.1:8409/iptv/xmltv.xml
Z0_OWNCAST_TOKEN=CHANGE-ME-owncast-access-token
# Optional: only follow one channel id from the guide, and prefix the marquee.
# Z0_CHANNEL_ID=1
# Z0_NOWPLAYING_PREFIX=CH0 ·

# --- Cluster (only matters with more than one playout node) --------------
# A unique name for this machine. Defaults to the hostname, which is fine right
# up until two nodes are both called "playout".
Z0_NODE_ID=playout-a
# Where the uplink lease lives. On a single node any local path works. With more
# than one playout node this MUST be storage they ALL write — the shared media
# mount is the obvious choice. Two nodes that can't see each other's lease will
# both go on air and corrupt the channel. See docs/clustering.tex.
Z0_CLUSTER_DIR_HOST=/media/channelz0/.z0-cluster
# Failover timing. TTL must stay comfortably above FENCE: the old leader stops
# publishing at FENCE, a standby takes over at TTL, and the gap between them is
# the margin that prevents two simultaneous publishers.
# Z0_LEASE_RENEW=5
# Z0_LEASE_FENCE=12
# Z0_LEASE_TTL=20

# --- ErsatzTV image (playout/compose.yml) --------------------------------
# PINNED, and not a "latest" tag on purpose: the old latest-vaapi/latest-nvidia
# tags are abandoned upstream (no -nvidia build after v25.2.0), so a node that
# follows them lands on a frozen image with no graphics engine and quietly
# cannot render the gutter rails.
ERSATZTV_TAG=v26.7.1

# Which encoder this MACHINE has. One image serves them all; this picks the
# hardware wiring that tools/bootstrap-node.sh writes into compose.hwaccel.yml.
#   nvenc | vaapi | qsv | software
Z0_HWACCEL=vaapi
# NVENC only: pin one card by UUID (nvidia-smi --query-gpu=uuid --format=csv).
# "all" works but wanders if the box has more than one GPU.
# Z0_NVIDIA_UUID=GPU-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Both compose files must be used together; bootstrap sets this for you.
COMPOSE_FILE=compose.yml:compose.hwaccel.yml
