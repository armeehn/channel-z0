# Channel Z0 — station environment
# Copy to .env (playout PC) or /etc/channel-z0.env (for the systemd unit),
# fill in real values. NEVER commit the filled-in version.

# Your domains (see docs/build-guide.md, Phase 0)
Z0_DOMAIN=channelz0.example
Z0_WATCH_DOMAIN=watch.channelz0.example

# The Owncast stream key you set in /admin (Phase 1.4). Long and random.
Z0_STREAM_KEY=CHANGE-ME

# Where ErsatzTV serves the channel on the playout PC (Phase 2)
Z0_CHANNEL_URL=http://127.0.0.1:8409/iptv/channel/1.ts

# Where submitted ads land after normalization (Phase: the ad pipeline)
Z0_MEDIA_ROOT=/media/channelz0
